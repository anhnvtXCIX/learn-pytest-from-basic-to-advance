# Copy to .env to run the app locally against docker-compose's Postgres/Redis:
#   cp .env.example .env && make compose-up && make migrate && uv run uvicorn shop.api.app:create_app --factory --reload
#
# The test suite ignores this file entirely -- it builds its own settings/fixtures.
SHOP_DATABASE_URL=postgresql+asyncpg://shop:shop@localhost:5432/shop
SHOP_REDIS_URL=redis://localhost:6379/0
SHOP_PAYMENT_GATEWAY_URL=https://payments.example.com
SHOP_PAYMENT_GATEWAY_API_KEY=test-payment-gateway-key
SHOP_API_KEY=test-client-api-key
SHOP_TAX_RATE=0.08
